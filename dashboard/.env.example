# Get both values from Supabase -> Settings -> API.
#
# VITE_SUPABASE_ANON_KEY must be the publishable/anon key, never the
# secret/service_role key: Vite bundles every VITE_-prefixed variable into
# the JavaScript shipped to the browser, so anything placed here is
# readable by every visitor of the deployed site.
#
# In production (Vercel) these are set in the project's Environment
# Variables settings, not in a file — this .env is for local `npm run dev`
# only and is git-ignored.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
